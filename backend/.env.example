# Copy to backend/.env for local development (never commit the real file).

# Local MongoDB, or a MongoDB Atlas connection string.
# Tip: `npm run demo` starts an in-memory MongoDB, so you can skip this to try the app.
MONGODB_URI=mongodb://127.0.0.1:27017/moviematch

# --- Sign-in: Google Identity Platform (Firebase Authentication) -------------------
# Leave these unset to use the local Firebase Auth emulator (`npm run demo` starts it;
# with `npm run dev`, run `npm run emulator` in another terminal and set the host below).
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
#
# For a real project: enable Identity Platform (the Google provider, plus Apple if used), then copy
# the values from Identity Platform → Providers → "Application setup details".
# FIREBASE_PROJECT_ID=your-gcp-project
# FIREBASE_API_KEY=AIza...            # public web key (identifies the project; not a secret)
# FIREBASE_AUTH_DOMAIN=your-gcp-project.firebaseapp.com
# Locally, the server also needs Google credentials to manage sessions:
#   gcloud auth application-default login
#
# Sign in with Apple: enable the Apple provider in Identity Platform (needs an Apple Developer
# account: a Services ID, a Sign in with Apple key, and the Firebase handler as return URL).

# Optional: real posters, overviews & runtimes from https://www.themoviedb.org/settings/api
# Without it the UI shows designed gradient cards.
TMDB_API_KEY=

PORT=8080

# Public origin users visit (password-reset links return here).
# With the Vite dev server use http://localhost:5173 (it proxies /api).
PUBLIC_URL=http://localhost:8080
